# ==================================================
# PERSONAL CONTROL CENTER - ENVIRONMENT CONFIGURATION
# ==================================================

# --------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (backend/.env)
# --------------------------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DATABASE_PATH=./database/personal-control-center.db
JWT_SECRET=super-secret-local-jwt-key-for-development-change-in-production

# --------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (frontend/.env)
# --------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_NAME="Personal Control Center"
VITE_DEFAULT_CURRENCY=USD
